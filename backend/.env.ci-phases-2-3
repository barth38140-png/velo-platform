# Configuration pour Phases 2 & 3 - Auto-Fixes et Prédictions ML

# ==============================================================================
# Phase 2: Auto-Fixes Configuration
# ==============================================================================

# Activer/désactiver le système d'auto-fixes
AUTO_FIXER_ENABLED=true

# Mode simulation: ne pas exécuter les fixes réellement
AUTO_FIXER_DRY_RUN=false

# Fixes qui requièrent une approbation explicite avant exécution
AUTO_FIXER_REQUIRE_APPROVAL=dbMigrations,productionChanges

# ==============================================================================
# Phase 2: GitHub Integration Configuration
# ==============================================================================

# Token d'authentification GitHub (obligatoire pour créer des issues)
# Générer sur: https://github.com/settings/tokens
# Scopes requis: repo (full control), read:org
GITHUB_TOKEN=

# Propriétaire du repository GitHub
GITHUB_OWNER=barth38140-png

# Nom du repository
GITHUB_REPO=velo-platform

# Activer/désactiver la création automatique d'issues
GITHUB_AUTO_CREATE_ISSUES=true

# Activer/désactiver la fermeture automatique d'issues
GITHUB_AUTO_CLOSE_ISSUES=true

# ==============================================================================
# Phase 3: Predictive Analytics Configuration
# ==============================================================================

# Activer/désactiver le système de prédictions ML
PREDICTIVE_ANALYTICS_ENABLED=true

# Taille de la fenêtre de métriques pour les prédictions
ML_WINDOW_SIZE=1000

# Horizon de prédiction en heures
ML_FORECAST_HORIZON=24

# Niveau de confiance (0.90-0.99)
ML_CONFIDENCE_LEVEL=0.95

# Alpha pour exponential smoothing (0.1-0.5)
ML_SMOOTHING_ALPHA=0.3

# Threshold pour anomaly detection par Z-score (2.0-3.5)
ML_ZSCORE_THRESHOLD=2.5

# Activer/désactiver la détection de saisonnalité
ML_DETECT_SEASONALITY=true

# ==============================================================================
# Intégration Phase 1-2-3: Monitoring Global
# ==============================================================================

# Intervalle de vérification de santé (ms)
CI_CHECK_INTERVAL=60000

# Intervalle de rapport quotidien (ms) - défaut: 24h
CI_DAILY_REPORT_INTERVAL=86400000

# Fichier de stockage des métriques
CI_METRICS_FILE=./backend/metrics/current.json

# Niveau de log pour le CI
CI_LOG_LEVEL=info

# ==============================================================================
# Notifications
# ==============================================================================

# Slack Integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_SEND_ALERTS=true
SLACK_SEND_DAILY_REPORTS=true

# Email Integration (TODO: nodemailer)
EMAIL_SEND_ALERTS=false
EMAIL_SEND_DAILY_REPORTS=false
ALERT_EMAIL=admin@velo-platform.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ==============================================================================
# Seuils d'Anomalies (Phase 1)
# ==============================================================================

# Taux d'erreur critique (pourcentage)
ANOMALY_ERROR_RATE_THRESHOLD=1.0

# Latence P95 critique (ms)
ANOMALY_LATENCY_P95_THRESHOLD=2000

# Spike d'erreur critique (pourcentage d'augmentation)
ANOMALY_ERROR_SPIKE_THRESHOLD=50

# Health score minimum avant alerte (0-100)
ANOMALY_HEALTH_SCORE_THRESHOLD=50

# ==============================================================================
# Mode Debug/Development
# ==============================================================================

# Activer le logging détaillé du CI
CI_DEBUG=false

# Activer le mode test (mock les services externes)
CI_TEST_MODE=false

# Nombre de logs à conserver en mémoire
CI_LOG_RETENTION=1000

