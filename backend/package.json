{
    "name": "velo-platform-backend",
    "version": "1.0.0",
    "main": "index.js",
    "license": "MIT",
    "scripts": {
        "smoke:test": "node tests/auth-smoke.js",
        "test": "node ./scripts/wait-for-db.js && cross-env NODE_ENV=test jest --runInBand",
        "dev": "nodemon index.js",
        "dev:local": "nodemon index.js",
        "start": "node index.js",
        "start:local": "node index.js",
        "lint": "eslint .",
        "seed:models": "node ./scripts/seed_bike_models.js",
        "db:migrate:messages": "psql -U postgres -d velo_platform -f ./sql/patch_add_conversations_and_messages.sql",
        "db:migrate:messages:test": "psql -U postgres -d velo_platform_test -f ./sql/patch_add_conversations_and_messages.sql",
        "metrics:health": "curl http://localhost:5000/api/metrics/health | jq .",
        "metrics:detailed": "curl -H 'Authorization: Bearer $TOKEN' http://localhost:5000/api/metrics/metrics | jq .",
        "metrics:recommendations": "curl -H 'Authorization: Bearer $TOKEN' http://localhost:5000/api/metrics/recommendations | jq .",
        "admin:status": "curl -H 'Authorization: Bearer $TOKEN' http://localhost:5000/api/admin/ci/status | jq .",
        "admin:auto-fixes": "curl -H 'Authorization: Bearer $TOKEN' http://localhost:5000/api/admin/auto-fixes | jq .",
        "admin:predictions": "curl -H 'Authorization: Bearer $TOKEN' http://localhost:5000/api/admin/predictions | jq .",
        "admin:health": "curl -H 'Authorization: Bearer $TOKEN' http://localhost:5000/api/admin/ci/system-health | jq .",
        "admin:anomalies": "curl -H 'Authorization: Bearer $TOKEN' http://localhost:5000/api/admin/ci/anomalies-detected | jq .",
        "admin:github-issues": "curl -H 'Authorization: Bearer $TOKEN' http://localhost:5000/api/admin/github-issues | jq ."
    },
    "dependencies": {
        "axios": "^1.13.2",
        "bcrypt": "^6.0.0",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "express": "^5.1.0",
        "express-rate-limit": "^8.2.1",
        "express-validator": "^7.3.0",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.2",
        "multer": "^1.4.5-lts.1",
        "pg": "^8.16.3",
        "pino": "^10.1.0",
        "pino-http": "^11.0.0",
        "pino-pretty": "^13.1.3",
        "socket.io": "^4.8.1",
        "web-push": "^3.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "cross-env": "^10.1.0",
        "dotenv": "^17.2.3",
        "eslint": "^9.39.1",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^16.5.0",
        "jest": "^30.2.0",
        "node-fetch": "^2.7.0",
        "nodemon": "^3.1.11",
        "supertest": "^7.1.4"
    }
}
