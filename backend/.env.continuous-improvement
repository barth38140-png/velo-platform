# Configuration pour le système d'amélioration continue
# À placer dans backend/.env ou définir les variables d'environnement

# Activation du monitoring continu
CONTINUOUS_IMPROVEMENT_ENABLED=true

# Seuils de détection d'anomalies
ANOMALY_ERROR_RATE_THRESHOLD=1
ANOMALY_LATENCY_THRESHOLD=2000
ANOMALY_ERROR_SPIKE_THRESHOLD=0.5

# Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
ALERT_EMAIL=admin@veloplatform.fr

# Logging
LOG_LEVEL=info

# Health check
HEALTH_CHECK_INTERVAL=60000
