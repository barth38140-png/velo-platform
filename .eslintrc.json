{
  "root": true,
  "env": {
    "node": true,
    "es2021": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "overrides": [
    {
      "files": ["cypress/**", "frontend/cypress/**"],
      "env": {
        "cypress": true,
        "browser": true,
        "es2021": true
      },
      "rules": {}
    },
    {
      "files": ["frontend/**"],
      "env": {
        "browser": true,
        "es2021": true
      },
      "extends": ["plugin:react/recommended"],
      "rules": {
        "react/react-in-jsx-scope": "off"
      }
    }
  ]
}
