{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:react/recommended"
  ],
  "overrides": [
    {
      "files": ["cypress/**/*.js", "cypress/**/*.cy.js", "cypress/**/*.ts"],
      "env": {
        "cypress": true,
        "browser": true,
        "es2021": true
      },
      "rules": {}
    },
    {
      "files": ["**/*.jsx", "**/*.js"],
      "rules": {
        "react/react-in-jsx-scope": "off"
      }
    }
  ],
  "settings": {
    "react": {
      "version": "detect"
    }
  }
}
